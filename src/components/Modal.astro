---
import { projects } from "@cv";
import Close from "@/icons/close.astro";
const { url } = Astro.props;
const { Icono } = Astro.props;

const { name } = Astro.props;
const project = projects.find((item) => item.name === name);
const isHorizontal = Boolean(
  project?.images &&
    !Array.isArray(project.images) &&
    "horizontal" in project.images &&
    project.images.horizontal,
);

const { Tipo } = Astro.props;
const isModal = Tipo === "Eye";
const isLink = Tipo === "NewPage";
---

<!-- Tipo -->
{isModal && (
    <button data-abrir={`modal-${name}`} class="button hover-grow">
      <Icono />
    </button>
)}
{isLink && (
    <a
      href={url}
      target="_blank"
      title={`Ir al proyecto ${name}`}
      class="button hover-grow"
    >
      <Icono />
    </a>
)}
<!-- Modal -->
<dialog class="dialog-content" id={`modal-${name}`}>
  <button data-cerrar={`modal-${name}`} class="close-button hover-grow">
    <Close />
  </button>
  <div class="modal-layout">
    <!-- Izquierdo -->
    <div class="modal-left">
      <h2 class="modal-title">{name}</h2>
      <p class="modal-description" data-i18n={`project.${name}.description`}>
        {project?.description}
      </p>
    </div>
    <!-- Divisor -->
    <div class="modal-divider"></div>
    <!-- Derecho -->
    <div class="modal-right" id="card-deck">
      {(Array.isArray(project?.images) ? project.images : project?.images?.imagenes)?.map((img: string, i: number) => (
          <img
            src={img}
            alt={`${name} screenshot ${i + 1}`}
            class={`modal-card ${isHorizontal ? "modal-card-horizontal" : ""}`}
            data-index={i}
          />
      ))}
    </div>
  </div>
</dialog>

<script>
  import { gsap } from "gsap";
  // Coordenadas de apertura y cierre
  const calcularOrigen = (boton: HTMLElement, dialog: HTMLDialogElement) => {
    const rect = boton.getBoundingClientRect();
    const dialogRect = dialog.getBoundingClientRect();

    const ox =
      ((rect.left + rect.width / 2 - dialogRect.left) / dialogRect.width) * 100;
    const oy =
      ((rect.top + rect.height / 2 - dialogRect.top) / dialogRect.height) * 100;

    return { ox, oy };
  };
  // Construye el clipPath colapsado hacia el origen
  const clipColapsado = (ox: number, oy: number) =>
    `inset(${oy}% ${100 - ox}% ${100 - oy}% ${ox}% round 8px)`;
  //Animaciones
  const abrirDialog = (boton: HTMLElement, dialog: HTMLDialogElement) => {
    dialog.showModal();
    const { ox, oy } = calcularOrigen(boton, dialog);

    gsap.fromTo(
      dialog,
      { clipPath: clipColapsado(ox, oy), opacity: 0, skewY: 4 },
      {
        clipPath: `inset(0% 0% 0% 0% round 8px)`,
        opacity: 1,
        skewY: 0,
        duration: 0.5,
        ease: "power3.out",
      },
    );
  };
  const cerrarDialog = (dialog: HTMLDialogElement) => {
    const modalId = dialog.id;
    const boton = document.querySelector(
      `[data-abrir="${modalId}"]`,
    ) as HTMLElement;
    const { ox, oy } = boton
      ? calcularOrigen(boton, dialog)
      : { ox: 50, oy: 50 };

    gsap.to(dialog, {
      clipPath: clipColapsado(ox, oy),
      opacity: 0,
      skewY: -8,
      duration: 0.35,
      ease: "power3.in",
      onComplete: () => {
        dialog.close();
        gsap.set(dialog, { clearProps: "all" });
      },
    });
  };
  //Manejo apertura y cierre
  document.querySelectorAll("[data-abrir]").forEach((btn) => {
    btn.addEventListener("click", (event) => {
      const boton = event.currentTarget as HTMLElement;
      const modalId = boton.getAttribute("data-abrir");
      const dialog = document.getElementById(modalId) as HTMLDialogElement;
      abrirDialog(boton, dialog);
    });
  });
  document.querySelectorAll("[data-cerrar]").forEach((btn) => {
    btn.addEventListener("click", (event) => {
      const modalId = (event.currentTarget as HTMLElement).getAttribute(
        "data-cerrar",
      );
      const dialog = document.getElementById(modalId) as HTMLDialogElement;
      if (dialog) cerrarDialog(dialog);
    });
  });
  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) cerrarDialog(dialog as HTMLDialogElement);
    });
  });
  ///ANIMACION CARTAS MODAL ABANICO
  document.querySelectorAll("#card-deck").forEach((deck) => {
    const cards = Array.from(deck.querySelectorAll(".modal-card"));
    const isHorizontalDeck = Boolean(deck.querySelector(".modal-card-horizontal"));
    const total = cards.length;
    const mid = (total - 1) / 2;
    const CONFIG = {
      arcSpread: 30,
      arcRise: 40,
      arcOffset: 18,
      hoverLift: 15,
      activeLift: isHorizontalDeck ? 60 : 20,
      duration: { fan: 0.4, hover: 0.2 },
      ease: "power2.out",
    };

    const fanProps = cards.map((_, i) => {
      const t = total > 1 ? (i - mid) / mid : 0;
      return {
        rotation: t * (CONFIG.arcSpread / 2),
        x: t * (total * CONFIG.arcOffset),
        y: t * t * CONFIG.arcRise,
        zIndex: i + 1,
      };
    });

    const toFan = (card: Element, i: number) =>
      gsap.to(card, {
        ...fanProps[i],
        scale: 1,
        duration: CONFIG.duration.fan,
        ease: CONFIG.ease,
      });
    const returnToFan = () => cards.forEach(toFan);
    let activeIndex: number | null = null;
    const resetDeck = () => {
      activeIndex = null;
      cards.forEach((card, i) =>
        gsap.set(card, {
          ...fanProps[i],
          scale: 1,
          transformOrigin: "bottom center",
        }),
      );
    };

    cards.forEach((card, i) =>
      gsap.set(card, { ...fanProps[i], transformOrigin: "bottom center" }),
    );
    gsap.from(cards, {
      y: 200,
      opacity: 0,
      rotation: 0,
      stagger: 0.08,
      duration: 0.6,
      ease: "back.out(1.4)",
    });

    const parentDialog = deck.closest("dialog");
    parentDialog?.addEventListener("close", resetDeck);

    cards.forEach((card, i) => {
      card.addEventListener("click", () => {
        returnToFan();
        if (activeIndex === i) {
          activeIndex = null;
          return;
        }
        gsap.to(card, {
          rotation: 0,
          x: 0,
          y: -CONFIG.activeLift,
          scale: 1.3,
          zIndex: total + 1,
          duration: CONFIG.duration.fan,
          ease: CONFIG.ease,
        });
        activeIndex = i;
      });

      card.addEventListener("mouseenter", () => {
        if (activeIndex === i) return;
        gsap.to(card, {
          y: fanProps[i].y - CONFIG.hoverLift,
          duration: CONFIG.duration.hover,
        });
      });

      card.addEventListener("mouseleave", () => {
        if (activeIndex === i) return;
        gsap.to(card, { y: fanProps[i].y, duration: CONFIG.duration.hover });
      });
    });
  });
</script>

<style>
  /* Dialog base */
  dialog {
    font-size: 1rem;
    font-weight: normal;
    font-family: Lucida Console, monospace;
    width: 700px;
    max-width: 90vw;
    border: none;
    border-radius: 16px;
    padding: 0;
    overflow: hidden;
    letter-spacing: normal;
    line-height: normal;
    background-color: var(--color-bg);
    color: var(--color-text);
  }
  dialog::backdrop {
    backdrop-filter: blur(0.7px);
  }
  /* Botones */
  .button {
    margin-bottom: 15px;
    margin-left: auto;
    border: none;
    background-color: transparent;
    cursor: pointer;
    border-radius: 4px;
  }
  .close-button {
    position: absolute;
    margin-top: 5px;
    top: 5px;
    right: 10px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 10;
  }
  /* Layout */
  .modal-layout {
    display: flex;
    height: 350px;
  }
  .modal-left {
    flex: 1;
    max-width: 300px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }
  .modal-title {
    font-size: 1.4rem;
    font-family:
      system-ui,
      -apple-system;
    color: var(--color-text-strong);
  }
  .modal-description {
    font-size: 0.85rem;
    color: var(--color-text-body);
    line-height: 1.6;
  }
  .modal-divider {
    width: 1px;
    background-color: var(--color-divider);
    align-self: stretch;
    margin: 1.5rem 0;
  }
  /* Cartas */
  .modal-right {
    flex: 1;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .modal-card {
    position: absolute;
    height: 240px;
    width: 110px;
    cursor: pointer;
    border-radius: 8px;
    box-shadow: 0 8px 24px var(--color-shadow-sm);
    transition: box-shadow 0.2s;
    user-select: none;
  }
  .modal-card-horizontal {
    height: 150px;
    width: 240px;
  }
  .modal-card:hover {
    box-shadow: 0 12px 32px var(--color-shadow-md);
  }
  /* Responsive */
  @media (width <= 700px) {
    .modal-layout {
      flex-direction: column;
      height: auto;
      min-height: 350px;
    }
    .modal-left {
      max-width: none;
    }
    .modal-divider {
      width: auto;
      height: 1px;
      margin: 0 1.5rem;
      margin-bottom: 5px;
    }
    .modal-right {
      height: 260px;
      flex: none;
    }
    .modal-card {
      height: 180px;
      width: 85px;
    }
    .modal-card-horizontal {
      height: 115px;
      width: 180px;
    }
  }
</style>