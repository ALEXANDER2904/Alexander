---
import Section from "../Section.astro"
import Cv from "@/icons/cv.astro"

import { presentation, basics, cv } from "@cv"
const { url } = cv
const { namep, subtitle } = presentation
const { name, estrella1, estrella2 } = basics
---

<Section id="name-section" >
    
    <div data-fit-text="90 998 main-content-title" class="main-content-title glitch-title" style="">
        <div class="nombre_con_cv">
          <span data-text={namep} class="nombre">{namep} </span>
          <div class="contenedor_cv">
            <div class="cv_icon">
              <a
                href={url}
                title={`Echa un vistazo a la hoja de vida de ${name} `}
                target="_blank"
                rel="noopener noreferrer"
                class="hover-grow"
                >
                <Cv/>
              </a>
            </div>
            <img class="imagen1" src={estrella1} alt="Estrella">
            <img class="imagen2" src={estrella2} alt="Estrella">
          </div>
        </div>
        <span data-text={subtitle} class="subtitulo">{subtitle}</span>
    </div>
</Section>

<script>
import { gsap } from "gsap";
import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";

gsap.registerPlugin(ScrambleTextPlugin);

const nombre = document.querySelector(".nombre");
const subtitulo = document.querySelector(".subtitulo");
const contenedor = document.querySelector(".main-content-title");

const scrambleCfg = (el: Element | null) => ({
  text: el?.textContent ?? "",
  chars: "!@#$%&*?/\\><[]{}",
  speed: 0.5,
});

gsap.timeline()
  .from(contenedor, { y: 40, opacity: 0, duration: 0.6, ease: "power3.out" })
  .to(nombre,    { duration: 1.5, scrambleText: scrambleCfg(nombre) })
  .to(subtitulo, { duration: 1.2, scrambleText: scrambleCfg(subtitulo) });

  //Animacion del glitch
  const triggerGlitch = () => {
  nombre?.classList.add("hovered");
  subtitulo?.classList.add("hovered");
  setTimeout(() => {
    nombre?.classList.remove("hovered");
    subtitulo?.classList.remove("hovered");
    }, 1000);
 };

    // Cada 5 segundos, ajusta el intervalo a tu gusto
    setInterval(triggerGlitch, 8000);
</script>

<style>
    /* ANIMACIONES GLITCH */
@keyframes noise-anim {
  0%   { clip-path: inset(25px 0 calc(100% - 58px) 0) }
  5%   { clip-path: inset(88px 0 calc(100% - 21px) 0) }
  10%  { clip-path: inset(94px 0 calc(100% - 28px) 0) }
  15%  { clip-path: inset(23px 0 calc(100% - 61px) 0) }
  20%  { clip-path: inset(20px 0 calc(100% - 47px) 0) }
  25%  { clip-path: inset(56px 0 calc(100% - 46px) 0) }
  30%  { clip-path: inset(100px 0 calc(100% - 18px) 0) }
  35%  { clip-path: inset(32px 0 calc(100% - 61px) 0) }
  40%  { clip-path: inset(51px 0 calc(100% - 26px) 0) }
  45%  { clip-path: inset(43px 0 calc(100% - 28px) 0) }
  50%  { clip-path: inset(90px 0 calc(100% - 26px) 0) }
  55%  { clip-path: inset(5px 0 calc(100% - 4px) 0) }
  60%  { clip-path: inset(20px 0 calc(100% - 69px) 0) }
  65%  { clip-path: inset(28px 0 calc(100% - 44px) 0) }
  70%  { clip-path: inset(33px 0 calc(100% - 73px) 0) }
  75%  { clip-path: inset(57px 0 calc(100% - 88px) 0) }
  80%  { clip-path: inset(25px 0 calc(100% - 69px) 0) }
  85%  { clip-path: inset(92px 0 calc(100% - 60px) 0) }
  90%  { clip-path: inset(49px 0 calc(100% - 4px) 0) }
  95%  { clip-path: inset(24px 0 calc(100% - 92px) 0) }
  100% { clip-path: inset(89px 0 calc(100% - 82px) 0) }
}

@keyframes noise-anim-2 {
  0%   { clip-path: inset(61px 0 calc(100% - 86px) 0) }
  5%   { clip-path: inset(64px 0 calc(100% - 36px) 0) }
  10%  { clip-path: inset(17px 0 calc(100% - 78px) 0) }
  15%  { clip-path: inset(89px 0 calc(100% - 92px) 0) }
  20%  { clip-path: inset(18px 0 calc(100% - 90px) 0) }
  25%  { clip-path: inset(55px 0 calc(100% - 54px) 0) }
  30%  { clip-path: inset(78px 0 calc(100% - 77px) 0) }
  35%  { clip-path: inset(30px 0 calc(100% - 98px) 0) }
  40%  { clip-path: inset(72px 0 calc(100% - 39px) 0) }
  45%  { clip-path: inset(94px 0 calc(100% - 89px) 0) }
  50%  { clip-path: inset(18px 0 calc(100% - 40px) 0) }
  55%  { clip-path: inset(54px 0 calc(100% - 91px) 0) }
  60%  { clip-path: inset(46px 0 calc(100% - 77px) 0) }
  65%  { clip-path: inset(45px 0 calc(100% - 27px) 0) }
  70%  { clip-path: inset(12px 0 calc(100% - 63px) 0) }
  75%  { clip-path: inset(96px 0 calc(100% - 8px) 0) }
  80%  { clip-path: inset(96px 0 calc(100% - 10px) 0) }
  85%  { clip-path: inset(26px 0 calc(100% - 68px) 0) }
  90%  { clip-path: inset(64px 0 calc(100% - 23px) 0) }
  95%  { clip-path: inset(31px 0 calc(100% - 63px) 0) }
  100% { clip-path: inset(27px 0 calc(100% - 6px) 0) }
}

/* GLITCH PSEUDO-ELEMENTOS — compartidos */
.glitch-title span:hover::before,
.glitch-title span:hover::after,
.glitch-title span.hovered::before,
.glitch-title span.hovered::after {
  content: attr(data-text);
  position: absolute;
  inset: 0;
  width: calc(100% + 2px);
  overflow: hidden;
  clip-path: inset(0 0 100% 0);
}

.glitch-title span:hover::before,
.glitch-title span.hovered::before {
  left: -2px;
  text-shadow: 1px 0 var(--color-glitch-shadow);
  animation: noise-anim-2 1s linear alternate-reverse
}

.glitch-title span:hover::after,
.glitch-title span.hovered::after {
  left: 2px;
  text-shadow: -1px 0 var(--color-glitch-shadow);
  animation: noise-anim 1s linear alternate-reverse;
}

/* ESTRELLAS */
.imagen1, .imagen2 {
  animation: fadeInOut var(--duracion, 8s) infinite;
}
.imagen1 { margin-top: -10px; width: 15px; height: 15px; }
.imagen2 { --duracion: 5s; margin-top: 3px; margin-left: -8px; width: 15px; height: 20px; }

@keyframes fadeInOut {
  0%, 100% { opacity: 0; }
  50%       { opacity: 1; }
}
/* LAYOUT */
.main-content-title {
  font-family: "Shadows Into Light", cursive;
  height: 250px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.main-content-title span {
  display: inline-block;
  position: relative;
}
.nombre_con_cv {
  position: relative;
  width: min(540px, 92vw);
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.nombre { 
  font-size: 80px; 
  width: 100%;
  text-align: center; 
  white-space: nowrap;
}
.subtitulo { 
  font-size: 45px; 
  text-align: center;
  margin-top: -40px; 
  margin-left: 250px;
}

/* CV */
.contenedor_cv {
  position: absolute;
  top: 10px;
  right: 0;
  transform: translateX(10%);
  display: flex;
  align-items: flex-start;
  margin-top: 0;
}
.cv_icon {
  color: var(--color-text-muted);
  font-size: 0.65rem;
  display: flex;
  gap: 4px;
  margin-top: 0;
}
.cv_icon a {
  color: var(--color-text-subtle);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border-subtle);
  padding: 4px;
  height: 32px;
  width: 32px;
  border-radius: 6px;
  transition: background 0.3s ease, border-color 0.3s ease;
}
.cv_icon a:hover {
  background: var(--color-surface);
  border-color: var(--color-border);
}
/* RESPONSIVE */
@media (width <= 700px) {
  .nombre_con_cv  { width: min(390px, 92vw); }
  .contenedor_cv  { top: 8px; transform: translateX(-30%); }
  .nombre        { font-size: 52px; margin-left:-50px; }
  .subtitulo     { font-size: 30px; margin-top: -25px; text-align: center; margin-left:110px}
}

</style>